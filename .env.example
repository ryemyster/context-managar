# ── Inference ──────────────────────────────────────────────────────────────────
# Defaults preserve the existing all-Ollama deployment.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_REASON_MODEL=qwen3.5:9b
OLLAMA_ARCH_MODEL=qwen3:4b
OLLAMA_AGENT_MODEL=qwen3:4b
OLLAMA_AGENT_SELECT_MODEL=qwen2.5-coder:3b
OLLAMA_AGENT_VERIFY_MODEL=qwen2.5-coder:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=32768

# Hybrid cloud generation + existing local embeddings:
# Supported generation providers: ollama, openai_compatible
# Aliases using the OpenAI-compatible transport: openai, openrouter, vllm
# INFERENCE_GENERATION_PROVIDER=openai_compatible
# INFERENCE_GENERATION_ENDPOINT=https://provider.example/v1
# INFERENCE_GENERATION_API_KEY=<secret>
# INFERENCE_FAST_MODEL=<cloud-model>
# INFERENCE_REASONING_MODEL=<cloud-model>
# INFERENCE_AGENT_MODEL=<cloud-model>
# INFERENCE_SELECTION_MODEL=<cloud-model>
# INFERENCE_VERIFICATION_MODEL=<cloud-model>
#
# Keep these values to preserve the existing 768-dimensional Supabase corpus:
# INFERENCE_EMBEDDING_PROVIDER=ollama
# INFERENCE_EMBEDDING_ENDPOINT=http://localhost:11434
# INFERENCE_EMBEDDING_MODEL=nomic-embed-text

# Legacy timeout names remain supported for backwards compatibility.
# Keep the per-call timeout well below the total so failures return through MCP.
OLLAMA_AGENT_TIMEOUT=3000
OLLAMA_AGENT_CALL_TIMEOUT=650
OLLAMA_AGENT_SELECT_TIMEOUT=45
OLLAMA_AGENT_MEMORY_TIMEOUT=10
OLLAMA_AGENT_VERIFY_TIMEOUT=60
OLLAMA_AGENT_NUM_PREDICT=400
AGENT_MAX_ITERATIONS=10
AGENT_MAX_REPAIR_ITERATIONS=3
AGENT_TOOL_RESULT_MAX_CHARS=3000

# ── Supabase ───────────────────────────────────────────────────────────────────
# Cloud project. Get these from: Supabase Dashboard → Project Settings → API
# SUPABASE_URL:              "Project URL"
# SUPABASE_SERVICE_ROLE_KEY: "service_role" secret (not the anon key)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional — only set if you rename the table or function in Supabase
# SUPABASE_VECTOR_TABLE=code_embeddings
# SUPABASE_MATCH_FUNCTION=match_code_embeddings

# ── Paths ───────────────────────────────────────────────────────────────────────
# REPO_ROOT: root of your repos directory (scanned read-only)
# OUTPUT_DIR: where artifact backups are written (Supabase is the primary store)
REPO_ROOT=/Users/<you>/Repos
OUTPUT_DIR="/Users/<you>/Library/Application Support/context-store/artifacts"

# ── Artifacts cleanup ──────────────────────────────────────────────────────────
# Oldest files evicted automatically once dir exceeds this size (0 = no limit)
ARTIFACTS_MAX_MB=50

# ── Retrieval limits ───────────────────────────────────────────────────────────
MAX_FILE_BYTES=262144
MAX_FILES_PER_SCAN=80
MAX_SNIPPETS_PER_QUERY=20

# ── Security ────────────────────────────────────────────────────────────────────
# API key enforcement. Leave unset (default) for local dev — all requests pass through.
# Cloud deployments: set to a strong secret. Callers must send X-API-Key: <value>.
# Health endpoints (/health, /healthcheck, /setup) are always exempt.
# CONTEXT_ENGINE_API_KEY=

# ── MCP adapter ────────────────────────────────────────────────────────────────
# Set these in the MCP host configuration when the REST service is not local or
# requires authentication. The stdio adapter defaults to http://localhost:8088.
# CONTEXT_ENGINE_URL=http://localhost:8088
# CONTEXT_ENGINE_MCP_HOST=127.0.0.1
# CONTEXT_ENGINE_MCP_PORT=8089
# CONTEXT_ENGINE_MCP_REQUEST_TIMEOUT=120
# CONTEXT_ENGINE_MCP_RUN_TIMEOUT=900
# CONTEXT_ENGINE_MCP_POLL_INTERVAL=1
# MCP_INLINE_LIMIT=1000

# ── Logging ─────────────────────────────────────────────────────────────────────
# LOG_FORMAT=json    # structured JSON output for cloud log aggregators (e.g. Datadog, CloudWatch)
# LOG_FORMAT=text    # human-readable (default)
# LOG_LEVEL=INFO     # TRACE | DEBUG | INFO | WARNING | ERROR
#   TRACE   — raw prompt/response content, per-file detail (very verbose)
#   DEBUG   — per-request tool calls, model timings, caller location in JSON output
#   INFO    — every request, startup/shutdown, slow threshold breaches (default)
#   WARNING — auth failures, non-fatal background errors
#   ERROR   — unhandled exceptions
# SLOW_REQUEST_MS=5000  # requests slower than this are logged at WARNING
