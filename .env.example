# ── Ollama ─────────────────────────────────────────────────────────────────────
# Ollama runs natively on the host (not in Docker).
# Install: brew install ollama
# Models:  ollama pull qwen2.5-coder:3b qwen3.5:9b nomic-embed-text
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_REASON_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Supabase ───────────────────────────────────────────────────────────────────
# Cloud project. Get these from: Supabase Dashboard → Project Settings → API
# SUPABASE_URL:              "Project URL"
# SUPABASE_SERVICE_ROLE_KEY: "service_role" secret (not the anon key)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional — only set if you rename the table or function in Supabase
# SUPABASE_VECTOR_TABLE=code_embeddings
# SUPABASE_MATCH_FUNCTION=match_code_embeddings

# ── Paths ───────────────────────────────────────────────────────────────────────
# REPO_ROOT: root of your repos directory (scanned read-only)
# OUTPUT_DIR: where artifact backups are written (Supabase is the primary store)
REPO_ROOT=/Users/<you>/Repos
OUTPUT_DIR=/Users/<you>/Library/Application Support/context-store/artifacts

# ── Artifacts cleanup ──────────────────────────────────────────────────────────
# Oldest files evicted automatically once dir exceeds this size (0 = no limit)
ARTIFACTS_MAX_MB=50
