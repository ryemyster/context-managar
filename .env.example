# ── Repo ──────────────────────────────────────────────────────────────────────
# Path to the repository to analyze (mounted read-only at /repo)
# Default: current directory (useful for testing on this repo itself)
REPO_PATH=.

# ── Ollama ─────────────────────────────────────────────────────────────────────
# Uses existing founderos-ollama container on founderos_default network.
# From inside Docker, this is the correct hostname.
# Do NOT change unless your Ollama container has a different name.
OLLAMA_HOST=http://founderos-ollama:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Supabase ───────────────────────────────────────────────────────────────────
# From inside Docker, context-engine reaches Supabase via its internal hostname.
# From the host (for scripts/testing), use http://localhost:54321
#
# Set SUPABASE_SERVICE_ROLE_KEY from: Supabase Dashboard → Settings → API → service_role
SUPABASE_URL=http://supabase_kong_checkin-ascendvent:8000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Vector table + function (created by supabase/migrations/20240101_code_embeddings.sql)
SUPABASE_VECTOR_TABLE=code_embeddings
SUPABASE_MATCH_FUNCTION=match_code_embeddings

# ── Scan limits (tuned for M3 Air 8GB) ────────────────────────────────────────
MAX_FILE_BYTES=32768
MAX_FILES_PER_SCAN=80
MAX_SNIPPETS_PER_QUERY=20
